# انسخ هذا الملف إلى .env على خادمك ثم أدخل قيمك الخاصة هناك.
# لا ترفع ملف .env الحقيقي إلى مستودع عام أو إلى مجلد الواجهة العامة.
NODE_ENV=production
PORT=3000

# قاعدة MySQL/TiDB مستقلة تستضيفها أنت أو مزود الاستضافة.
DATABASE_URL=mysql://USER:PASSWORD@DB_HOST:3306/DB_NAME

# أنشئ بيانات دخول جديدة قوية للوحة الأدمن على الاستضافة.
DEEGA_ADMIN_USERNAME=change-this-username
DEEGA_ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters

# مطلوبان إذا أبقيت رفع الصور وإيصالات إنستاباي مربوطًا بتخزين Manus.
# الاستضافة الخارجية لا ترث مفاتيح مشروع Manus تلقائيًا.
MANUS_API_URL=
MANUS_API_KEY=

# اختيارية فقط إذا كنت تستخدم مصادقة Manus OAuth في هذا النشر.
MANUS_PROJECT_ID=
MANUS_JWT_SECRET=
MANUS_OAUTH_API_URL=
MANUS_OAUTH_PORTAL_URL=
MANUS_API_BROWSER_KEY=
OWNER_OPEN_ID=
